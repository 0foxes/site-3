server {
    server_name .com www..com;

    location / {
        include proxy_params;
        proxy_pass http://unix:/home//-new/src/website.sock;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    location /files {
        alias /home//-new/src/files/;
	autoindex on;
	autoindex_exact_size off;
    }
}
server {
    if ($host = www..com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = .com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name .com www..com;
    return 404; # managed by Certbot
}
